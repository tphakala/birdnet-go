[Unit]
Description=BirdNET-Go Container
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/tphakala/birdnet-go:nightly
ContainerName=birdnet-go
Volume=./config:/config
Volume=./data:/data
PublishPort=8080:8080
Environment=TZ=UTC
Environment=BIRDNET_UID=1000
Environment=BIRDNET_GID=1000
AddDevice=-/dev/snd:/dev/snd
# Rootless audio (opt-in): uncomment the two lines below to reach the sound card
# under rootless Podman. It runs the app as your host UID, so an EXISTING install
# must re-own its volumes first, and it needs the crun OCI runtime (install crun;
# Podman then uses it). A fresh install via podman-install.sh does both for you.
# See Podman/README.md (Rootless Audio Access).
#UserNS=keep-id
#GroupAdd=keep-groups
Network=bridge
Tmpfs=/config/hls:exec,size=50M,mode=1777

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target