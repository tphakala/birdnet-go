#!/bin/sh
set -eu  # Exit on error, treat unset variables as error

# Go backend checks
echo "🔍 Running backend pre-commit checks..."

# Check if any Go files are being committed (including renames, excluding generated/vendor)
GO_FILES=$(git diff --cached --name-only --diff-filter=ACMR | \
  grep '\.go$' | \
  grep -v '^vendor/' | \
  grep -v '^third_party/' | \
  grep -v '_gen\.go$' | \
  grep -v '/generated/' | \
  grep -v '\.pb\.go$' || true)

if [ -n "$GO_FILES" ]; then
  echo "📝 Go files detected in commit, running golangci-lint..."
  
  # Check if golangci-lint is available
  if ! command -v golangci-lint >/dev/null 2>&1; then
    echo "❌ golangci-lint is not installed or not in PATH"
    echo "💡 Install it with: curl -sSfL https://golangci-lint.run/install.sh | sh -s -- -b \$(go env GOPATH)/bin v2.13.2"
    exit 1
  fi
  
  # Check and auto-format Go files
  echo "   Checking Go code formatting..."
  UNFORMATTED=$(echo "$GO_FILES" | xargs gofmt -l)
  
  if [ -n "$UNFORMATTED" ]; then
    echo "🔧 Auto-formatting Go files:"
    echo "$UNFORMATTED" | sed 's/^/     /'
    
    # Format the files
    echo "$UNFORMATTED" | xargs gofmt -w
    
    # Re-stage the formatted files
    echo "$UNFORMATTED" | xargs git add
    
    echo "✅ Go files formatted and re-staged automatically"
  else
    echo "✅ All Go files are properly formatted"
  fi
  
  # Run golangci-lint with the default build tags of `task lint`
  # (noembed,skipfrontend skip model and frontend embedding, which also makes
  # the run faster). CI additionally lints the integration, pebble_e2e and
  # normcompare tags. The CGO settings are the ones `task lint` sets, so the
  # TFLite cgo packages typecheck whatever the environment holds.
  REPO_ROOT=$(git rev-parse --show-toplevel)
  CACHE_DIR="$REPO_ROOT/.cache"
  if [ ! -d "$CACHE_DIR/tensorflow" ]; then
    # A linked worktree has no .cache of its own; use the main checkout's.
    CACHE_DIR="$(git rev-parse --path-format=absolute --git-common-dir)/../.cache"
  fi
  case "$(uname -s)_$(uname -m)" in
    Darwin_arm64) LIB_DIR="/opt/homebrew/lib" ;;
    Darwin_*) LIB_DIR="/usr/local/lib" ;;
    *) LIB_DIR="/usr/lib" ;;
  esac
  export CGO_ENABLED=1
  export CGO_CFLAGS="-I$CACHE_DIR/tensorflow -I$CACHE_DIR/openvino/include"
  export CGO_LDFLAGS="-L$LIB_DIR -ltensorflowlite_c"
  echo "   Linting Go files..."
  if ! golangci-lint run -v --build-tags=noembed,skipfrontend; then
    echo "❌ golangci-lint found issues in Go files"
    echo "💡 Fix the issues above before committing"
    echo "⚠️  Note: --no-verify bypasses are not accepted in this project"
    exit 1
  fi
  echo "✅ golangci-lint passed for all Go files"
else
  echo "📄 No Go files in this commit, skipping golangci-lint"
fi

# Check species dictionaries when OpenFauna data or generator changes
SPECIES_DICT_TRIGGER=$(git diff --cached --name-only --diff-filter=ACMR | \
  grep -E 'internal/openfauna/data/translations\.csv\.gz$|internal/openfauna/data/SOURCE\.txt$|internal/openfauna/data/locales\.txt$|internal/openfauna/dictionary\.go$|internal/openfauna/resolver\.go$|internal/speciesdict/gen/main\.go$|internal/speciesdict/data/' || true)

if [ -n "$SPECIES_DICT_TRIGGER" ]; then
  echo "🐦 Checking species dictionaries..."
  go generate ./internal/speciesdict
  if ! git diff --quiet -- internal/speciesdict/data; then
    echo "❌ Species dictionaries are out of date."
    echo "💡 Run: go generate ./internal/speciesdict, then stage internal/speciesdict/data"
    exit 1
  fi
  echo "✅ Species dictionaries are in sync"
fi

# Frontend checks
echo "🔍 Running frontend pre-commit checks..."
cd frontend || exit 1

# Check i18n key sync if translation files are staged.
# The frontend/ prefix is optional so the match still works under git diff.relative=true
# (paths come out relative to the frontend/ cwd set above).
I18N_FILES=$(git diff --cached --name-only --diff-filter=ACMR | \
  grep -E '(frontend/)?static/messages/[^/]*\.json$' || true)

if [ -n "$I18N_FILES" ]; then
  echo "🌍 Checking i18n key sync..."
  npm run i18n:sync:check || {
    echo "❌ i18n keys out of sync. Run: cd frontend && npm run i18n:sync"
    exit 1
  }
  echo "✅ i18n keys in sync"
fi

# Check generated i18n types when en.json, the generator, or the generated file changes.
# The frontend/ prefix is optional so the match still works under git diff.relative=true
# (paths come out relative to the frontend/ cwd set above).
I18N_TYPES_TRIGGER=$(git diff --cached --name-only --diff-filter=ACMR | \
  grep -E '(frontend/)?static/messages/en\.json$|(frontend/)?src/lib/i18n/generateTypes\.ts$|(frontend/)?src/lib/i18n/types\.generated\.ts$|(frontend/)?src/lib/i18n/icuMessage\.ts$' || true)

if [ -n "$I18N_TYPES_TRIGGER" ]; then
  echo "🌍 Checking generated i18n types..."
  npm run generate:i18n-types:check || {
    echo "❌ i18n types out of sync. Run: cd frontend && npm run generate:i18n-types"
    exit 1
  }
  echo "✅ i18n types in sync"
fi

# Run lint-staged for staged files first (faster feedback)
echo "🧹 Running lint-staged..."
npx lint-staged || exit 1

# Run TypeScript/Svelte type checking on staged files only
echo "📝 Type checking staged files..."
# Get staged .ts, .svelte files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|svelte)$' | head -20)

if [ -n "$STAGED_FILES" ]; then
  echo "Checking types for staged files..."
  npm run typecheck || {
    echo "❌ TypeScript errors found in staged files."
    echo "💡 Fix errors before committing"
    echo "⚠️  Note: --no-verify bypasses are not accepted in this project"
    exit 1
  }
else
  echo "ℹ️ No TypeScript/Svelte files staged, skipping typecheck"
fi

echo "✅ All pre-commit checks passed!"
